<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Aula05MvvmAPI.ViewModels"
             x:Class="Aula05MvvmAPI.MainPage">
    <ContentPage.BindingContext>
        <viewmodel:CepViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Digite o CEP" Text="{Binding Cep}"/>

            <Button Text="Buscar Endereço" Command="{Binding BuscarCepCommand}" />

            <Label Text="{Binding Endereco.Logradouro}"/>
            <Label Text="{Binding Endereco.Bairro}"/>
            <Label Text="{Binding Endereco.Localidade}"/>
            <Label Text="{Binding Endereco.Uf}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
